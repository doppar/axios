{
    "name": "doppar/axios",
    "description": "Doppar Axios is a modern, HTTP client package for PHP",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/doppar/axios/issues",
        "source": "https://github.com/doppar/axios"
    },
    "authors": [
        {
            "name": "Mahedi Hasan",
            "email": "mahedy150101@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "symfony/http-client": "^8.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Axios\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
